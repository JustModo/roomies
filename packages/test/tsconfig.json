{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@roomies/web/*": ["../../apps/web/*"],
      "@roomies/server/*": ["../../apps/api/*"]
    }
  },
  "include": ["src/**/*", "../../apps/api/src/types.d.ts"]
}
