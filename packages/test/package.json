{
  "name": "@roomies/test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@roomies/contracts": "workspace:*",
    "@roomies/library": "workspace:*",
    "@roomies/server": "workspace:*",
    "@roomies/transcoding": "workspace:*",
    "fastify": "^5.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.5.10",
    "prisma": "^7.8.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
