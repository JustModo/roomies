generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("guest") // "root" or "guest"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
}

model Library {
  id        String   @id @default(uuid())
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movies Movie[]
}

model Movie {
  id        String   @id @default(uuid())
  libraryId String
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  type      String   // "movie" or "show"
  name      String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaFiles MediaFile[]
}

model MediaFile {
  id        String   @id @default(uuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  title     String
  path      String
  duration  Int      @default(0) // Duration in seconds
  number    Int?
  // Source file's mtime at last probe — lets a rescan skip re-running ffprobe/audio/subtitle
  // extraction for files that haven't changed, instead of unconditionally re-probing everything.
  sourceMtimeMs Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtitles   Subtitle[]
  audioTracks AudioTrack[]
}

model Subtitle {
  id          String    @id @default(uuid())
  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  path        String    @unique
  language    String?
  // Null for user-uploaded subtitles; set for ones extracted from an embedded stream,
  // so a rescan can tell which streams are still present and prune the rest.
  streamIndex Int?
  createdAt   DateTime  @default(now())

  @@unique([mediaFileId, streamIndex])
}

model AudioTrack {
  id          String    @id @default(uuid())
  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  streamIndex Int
  language    String?
  title       String?
  channels    Int?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([mediaFileId, streamIndex])
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ServerConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
