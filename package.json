{
  "name": "@roomies",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "docker compose up --build",
    "dev": "concurrently \"docker compose -f docker-compose.dev.yml up\" \"turbo run dev\"",
    "dev:api": "concurrently -k \"docker compose -f docker-compose.dev.yml up\" \"pnpm --filter @roomies/server dev\"",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @roomies/test test:e2e",
    "test:e2e:ui": "pnpm --filter @roomies/test test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @roomies/test test:e2e:headed",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/api/src/**/*.ts\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "turbo": "^2.10.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@11.22.0"
}
