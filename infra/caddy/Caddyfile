# Roomies reverse proxy configuration
{
    admin off
    log {
        output stderr
        format console
    }
}

:5123 {
    # Fastify API backend
    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }

    # WebSocket gateway
    handle /ws* {
        reverse_proxy 127.0.0.1:3000
    }

    # HLS media delivery
    handle /hls/* {
        root * /cache
        uri strip_prefix /hls
        file_server

        # Immutable segment caching and uncached playlists.
        @segments path *.ts
        header @segments Cache-Control "public, max-age=31536000, immutable"

        @playlists path *.m3u8
        header @playlists Cache-Control "no-store, no-cache, must-revalidate"
    }

    # Static web app frontend
    handle {
        root * /app/apps/web/dist
        try_files {path} {path}/ /index.html
        file_server
    }
}
