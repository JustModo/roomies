# Roomies reverse proxy configuration (development)
{
    admin off
    log {
        output stderr
        format console
    }
}

:5123 {
    # Fastify API backend
    handle /api/* {
        reverse_proxy host.docker.internal:3000
    }

    # WebSocket gateway
    handle /ws* {
        reverse_proxy host.docker.internal:3000
    }

    # HLS media delivery
    handle /hls/* {
        root * /cache
        uri strip_prefix /hls
        file_server

        header {
            Access-Control-Allow-Origin *
        }

        # Immutable segment caching and uncached playlists.
        @segments path *.ts
        header @segments Cache-Control "public, max-age=31536000, immutable"

        @playlists path *.m3u8
        header @playlists Cache-Control "no-store, no-cache, must-revalidate"
    }

    # Vite development server
    handle {
        reverse_proxy host.docker.internal:5173
    }
}
